rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // A helper function to check if the requester is an admin of a specific department.
    function isDepartmentAdmin(departmentId) {
      let userProfile = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return request.auth != null &&
             userProfile.role == 'department_admin' &&
             userProfile.departmentId == departmentId;
    }

    // A helper function to check if the requester is any admin.
    function isAnyAdmin() {
      let userProfile = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return request.auth != null &&
             userProfile.role == 'department_admin';
    }

    // Users collection can only be read by the user themselves.
    // User creation is open (for signup), but updates are restricted.
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null;
      allow update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false; 
    }

    // Subjects can be read by anyone.
    match /subjects/{subjectId} {
      allow read: if true;
      // On create, check the incoming data's departmentId.
      allow create: if isDepartmentAdmin(request.resource.data.departmentId);
      // On update/delete, check the existing data's departmentId.
      allow update, delete: if isDepartmentAdmin(resource.data.departmentId);
    }

    // Event Categories are global. They can be read by anyone.
    // Only any admin can manage them.
    match /eventCategories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAnyAdmin();
    }

    // Events can be read by anyone.
    match /events/{eventId} {
      allow read: if true;
      // On create, check the incoming data's departmentId.
      allow create: if isDepartmentAdmin(request.resource.data.departmentId);
      // On update/delete, check the existing data's departmentId.
      allow update, delete: if isDepartmentAdmin(resource.data.departmentId);
    }
  }
}
